# .env.example
# Copy this to .env and fill with your values

# Server
NODE_ENV=development
PORT=3000
JWT_SECRET=your-super-secret-key-here-minimum-32-characters-long

# Database
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/p2p

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://share.rumnnlg.com

# TURN Servers (optional)
INDIA_TURN_HOST=turn.india.example.com
INDIA_TURN_USER=username
INDIA_TURN_PASS=password

METERED_USER=metered-username
METERED_PASS=metered-password

# Proxy configuration (if behind nginx/ALB)
SEC_TRUST_PROXY=false
