# ═══════════════════════════════════════════════════════════════
# Tranzo — Configuration
# NODE_ENV=development → all security guards OFF, all origins allowed
# NODE_ENV=production  → all guards ON, set ALLOWED_ORIGINS below
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

JWT_SECRET=your-super-secret-key-here-minimum-32-characters-long-change-in-production

# Redis (optional — app works without it)
REDIS_URL=redis://localhost:6379

# MongoDB Atlas
MONGO_URL=mongodb+srv://lalityadav0075:Tranzo2024@cluster0.s09w5.mongodb.net/tranzo?retryWrites=true&w=majority&appName=Cluster0

# CORS — only needed in production. In development all origins are allowed automatically.
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# TURN Servers (optional)
INDIA_TURN_HOST=
INDIA_TURN_USER=
INDIA_TURN_PASS=

METERED_USER=
METERED_PASS=

# Trust Proxy
SEC_TRUST_PROXY=false
