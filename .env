# ═══════════════════════════════════════════════════════════════
# Tranzo — Complete Configuration
# ─────────────────────────────────────────────────────────────
# NODE_ENV=development → all security guards OFF, all origins allowed
# NODE_ENV=production  → all guards ON, CORS locked, rate limiting ON
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────
# Both keys supported — MONGO_URL is the new name, MONGODB_URI is the old name.
# Current config reads MONGO_URL first, falls back to MONGODB_URI.
# Keep BOTH to stay compatible with old code.
MONGO_URL=mongodb+srv://lalityadav0075:Tranzo2024@cluster0.s09w5.mongodb.net/tranzo?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://lalityadav0075:Tranzo2024@cluster0.s09w5.mongodb.net/tranzo?retryWrites=true&w=majority&appName=Cluster0

# ─── Redis ────────────────────────────────────────────────────
# Local dev:   redis://localhost:6379
# Upstash:     rediss://user:pass@host:port
# Leave blank to disable caching (app works without Redis)
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
# PRODUCTION: generate a real secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=3238a9c0d03453d3171ce15b7a8f10170b1a19fe38bbc932d4a8e1fd535bb842e5f91ae1cf15032bffb00c3de239dc51752eead447136928d75a4f7596a69e47
JWT_EXPIRES=30d

# ─── Site URLs ────────────────────────────────────────────────
SITE_URL=https://share.rumnnlg.com
APP_URL=https://share.rumnnlg.com

# ─── CORS (production only) ───────────────────────────────────
# In development all origins allowed automatically.
# In production: set this to your domain(s), comma-separated.
# ALLOWED_ORIGINS=https://share.rumnnlg.com

# ─── Admin & Security ─────────────────────────────────────────
# PRODUCTION: change both to long random strings
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-this-to-a-long-random-string
CACHE_PURGE_SECRET=change-this-to-a-long-random-string

# ─── Trust Proxy ──────────────────────────────────────────────
# Set true if behind nginx, Cloudflare, or any reverse proxy
SEC_TRUST_PROXY=false

# ─── TURN / ICE Servers (optional) ───────────────────────────
# For WebRTC relay when direct P2P fails (firewalled networks)
INDIA_TURN_HOST=
INDIA_TURN_USER=
INDIA_TURN_PASS=

METERED_USER=
METERED_PASS=

# ─── Ghost CMS (blog) ─────────────────────────────────────────
GHOST_URL=http://localhost:2368
GHOST_CONTENT_KEY=deb93f55579ac2a51aeff9bb3a
GHOST_ADMIN_KEY=69b932fcba22530fa849d985:13e1e41706500f2ba53ca968cc1b4cb4aa4b91f722c7c922c9666bf5873c759e

# ─── Blog cache TTLs (seconds) ────────────────────────────────
CACHE_TTL_LIST=300
CACHE_TTL_POST=600
CACHE_TTL_PAGE=3600
BLOG_PAGE_SIZE=12

# ─── Email / SMTP (optional) ──────────────────────────────────
# For login notifications. Leave blank to disable silently.
# Gmail: SMTP_HOST=smtp.gmail.com, PORT=587
# Gmail app password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@tranzo.app

# ─── Strapi CMS (old integration — keep if still used) ────────
# If you no longer use Strapi, these can be removed.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=b98ccb78fd4099a4d35afc406aa0fcafb6a070cb058f8cf26f76fdefac9134f2d916dd074a36819b122bcc21a51b80e668ebcda5a2515e52bde4672b0ccc8f88378538b3ff828a4b671db55c9e4f91fc1bdb7e45cd88c0fbf11ed7792006421e4a4a8d82df950be438aa067d0b5a0f13a83c3966e9aea221e2981038f190fab7